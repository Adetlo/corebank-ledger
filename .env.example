# Copy to .env for local development. Never commit a real .env.
DATABASE_URL=postgresql+psycopg://corebank:corebank_dev_only@localhost:5432/corebank
APP_ENV=development
LOG_LEVEL=INFO
LOG_FORMAT=console

# Optional tuning
# DATABASE_POOL_SIZE=5
# DATABASE_MAX_OVERFLOW=10
# MAX_REQUEST_BYTES=262144
# REQUIRE_IDEMPOTENCY_KEY=true

# Tests: point at an existing PostgreSQL instead of the embedded one
# TEST_DATABASE_URL=postgresql+psycopg://corebank:corebank_dev_only@localhost:5432/corebank_test
